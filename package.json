{
  "name": "js-playground",
  "version": "1.0.0",
  "private": true,
  "description": "JS playground with Postgres-backed tabs (Lit + Vite + TypeScript)",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "SERVE_STATIC=0 node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "codemirror": "^5.65.21",
    "express": "^4.21.2",
    "lit": "^3.3.3",
    "pg": "^8.13.3",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@types/codemirror": "^5.60.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "concurrently": "^10.0.3",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
